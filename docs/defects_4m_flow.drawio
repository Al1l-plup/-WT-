        <mxCell id="aoto" value="Передать в ОТО" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0e8088;fontColor=#0a5f66;exitX=0.2;exitY=1;entryX=0.6;entryY=0;" edge="1" parent="1" source="band" target="ot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aotoback" value="контрмера →&#10;назад отправителю" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0e8088;fontColor=#0a5f66;exitX=0.12;exitY=0;entryX=0.28;entryY=1;" edge="1" parent="1" source="ot" target="band">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="abounce" value="Вернуть выбранному отделу&#10;(+ обязательный коммент, return_count++)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;fontColor=#8a2f2a;exitX=0;exitY=0.35;entryX=0;entryY=0.72;" edge="1" parent="1" source="band" target="band">
          <mxGeometry relative="1" as="geometry">
