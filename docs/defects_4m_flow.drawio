        <mxCell id="areopen" value="WeldTeam: переоткрыть&#10;→ отделу, что закрывал" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#9673a6;fontColor=#5a3d73;exitX=1;exitY=0.5;entryX=1;entryY=0.92;" edge="1" parent="1" source="cl" target="band">
          <mxGeometry relative="1" as="geometry">
