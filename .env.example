# Пример конфигурации WeldTeam MES. Скопируйте в файл `.env` рядом и заполните.
# В git попадает только этот пример; сам `.env` игнорируется (в нём секреты).

# Профиль: development | production. На сервере — production.
FLASK_ENV=production

# СЕКРЕТНЫЙ КЛЮЧ подписи сессий — ОБЯЗАТЕЛЬНО сменить на сервере!
# Сгенерировать:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ЗАМЕНИТЕ-НА-СЛУЧАЙНЫЙ-КЛЮЧ

# Адрес и порт. 0.0.0.0 = доступен по локальной сети; порт по умолчанию 5000.
HOST=0.0.0.0
PORT=5000

# Путь к файлу БД (по умолчанию data/welding_shop.db в папке проекта).
# WELDTEAM_DB_PATH=C:/WeldTeam/data/welding_shop.db

# Почта администратора (аккаунт с этим логином получает роль admin автоматически).
ADMIN_EMAIL=al.galimov@astana-motors.kz

# Уровень логов: INFO | WARNING | ERROR
LOG_LEVEL=INFO
