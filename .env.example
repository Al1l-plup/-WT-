# Пример настроек окружения. Скопируйте в .env и при необходимости измените.
#   cp .env.example .env   (Windows: copy .env.example .env)
# Файл .env в репозиторий НЕ коммитится (см. .gitignore).

# Профиль: development | production
FLASK_ENV=development

# Секретный ключ Flask (обязательно смените для продакшна!)
SECRET_KEY=change-me-to-a-random-secret

# Сеть
HOST=0.0.0.0
PORT=5000

# Путь к БД (по умолчанию data/welding_shop.db в корне проекта).
# Раскомментируйте, чтобы переопределить:
# WELDTEAM_DB_PATH=C:/path/to/welding_shop.db
