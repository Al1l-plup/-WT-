<mxfile host="app.diagrams.net" type="device">
  <diagram id="defects4m" name="Дефекты 4M — как работает">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Процесс дефектов 4M — как работает сейчас (вкладка «Дефекты», DEV)" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="18" width="650" height="30" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="① ОТК выявил дефект&#10;точка / пистолет + код дефекта&#10;фото — опционально" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="355" y="70" width="310" height="70" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="Серийный&#10;повтор?&#10;(та же точка + группа кода,&#10;≤ 7 дней от закрытого)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="405" y="185" width="210" height="120" as="geometry" />
        </mxCell>

        <mxCell id="sr" value="СЕРИЙНЫЙ: переоткрыть родителя&#10;(is_serial, return_count++)&#10;→ вернуть отделу, что закрывал" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="720" y="200" width="330" height="90" as="geometry" />
        </mxCell>

        <mxCell id="nd" value="② Создан дефект →&#10;вход в цепочку (по коду)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="345" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="band" value="НА РАССМОТРЕНИИ — текущий отдел цепочки&#10;(действует только отдел этого этапа; WeldTeam = админ, действует всегда)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="110" y="470" width="860" height="240" as="geometry" />
        </mxCell>

        <mxCell id="pr" value="Производство&#10;Man — ошибки оператора" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="160" y="555" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wt" value="WeldTeam&#10;Machine — параметры сварки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="430" y="555" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="it" value="ИТО&#10;Method + Material" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="710" y="555" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="un" value="НЕ ВЫЯВЛЕНО&#10;конец цепочки →&#10;недельный разбор" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="555" width="165" height="80" as="geometry" />
        </mxCell>

        <mxCell id="otk" value="ОТК — перепроверка точки&#10;(pending_otk: закрыто отделом, ждёт ОТК)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="760" width="320" height="66" as="geometry" />
        </mxCell>

        <mxCell id="cl" value="ЗАКРЫТ ✓&#10;ОТК согласовал закрытие" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="655" y="885" width="215" height="64" as="geometry" />
        </mxCell>
        <mxCell id="ot" value="ОТО — оборудование&#10;несоосности, неисправности" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="150" y="775" width="250" height="66" as="geometry" />
        </mxCell>

        <mxCell id="lg" value="РОЛИ И ПРАВИЛА (текущая логика):&#10;&#10;• ОТК — выявляет и регистрирует дефект (фото опционально, флаг REQUIRE_DEFECT_PHOTO).&#10;• 4M-ответственность: Machine → WeldTeam (параметры), Man → Производство (оператор), Method / Material → ИТО, Оборудование → ОТО.&#10;• Цепочка по умолчанию: Производство → WeldTeam → ИТО. Для кодов EO и MN отдел WeldTeam пропускается.&#10;• Кросс-процесс (передать дальше / вернуть / в ОТО / переоткрыть) — комментарий ОБЯЗАТЕЛЕН.&#10;• Закрытие: отдел указывает причину + контрмеру + VIN → дефект уходит на перепроверку точки в ОТК (pending_otk). ОТК согласует → ЗАКРЫТ; не согласует → возврат закрывшему отделу (+возврат, комментарий обязателен).&#10;• На этапе действует только отдел текущего этапа; WeldTeam — админ: действует на любом этапе и единственный переоткрывает закрытые.&#10;• Приоритет в списке: точки группы B ▸ серийные ▸ обычные.&#10;• Серийность: повтор на той же точке в той же группе кодов ({MN} / {EO} / прочие) в пределах 7 дней от закрытого/ожидающего ОТК → переоткрывается как серийный." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="965" width="1075" height="215" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="s1" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="Да ▸" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="sr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1" target="nd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="старт цепочки" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="nd" target="pr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="на этап отдела,&#10;что закрывал" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="sr" target="band">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="передать ▸" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="pr" target="wt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="передать ▸" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="wt" target="it">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="EO / MN&#10;(без WeldTeam)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;fontColor=#b46504;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="pr" target="it">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="255" y="685" />
              <mxPoint x="805" y="685" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="передать:&#10;конец цепочки" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="it" target="un">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="aclose" value="Закрыть:&#10;причина + контрмера + VIN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#82b366;fontColor=#2d6a2d;exitX=0.82;exitY=1;entryX=0.35;entryY=0;" edge="1" parent="1" source="band" target="otk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eotkok" value="ОТК согласовал" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#82b366;fontColor=#2d6a2d;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="otk" target="cl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eotkno" value="ОТК не согласовал&#10;(+коммент) → закрывшему" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#b85450;fontColor=#8a2f2a;exitX=0.88;exitY=0;entryX=0.97;entryY=1;" edge="1" parent="1" source="otk" target="band">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="990" y="742" />
